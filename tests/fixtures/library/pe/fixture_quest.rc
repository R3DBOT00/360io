// Version resource written by a real resource compiler (llvm-rc) so the PE
// parser is exercised on toolchain output, not only on synthetic buffers.
1 VERSIONINFO
FILEVERSION 1,2,3,4
PRODUCTVERSION 1,2,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Fixture Studio"
      VALUE "FileDescription", "Fixture Quest Game"
      VALUE "FileVersion", "1.2.3.4"
      VALUE "InternalName", "FixtureQuest"
      VALUE "OriginalFilename", "FixtureQuest.exe"
      VALUE "ProductName", "Fixture Quest"
      VALUE "ProductVersion", "1.2"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
